# Vercel's Supabase integration should provision the project URL and a
# publishable / anon public key for Production and Preview. Check targets.
# Do NOT commit any real credential values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_PLACEHOLDER
# Alternative supported by the site:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Authentication uses Supabase Auth. A private administrator must be
# added to public.grocery_admins via Supabase SQL Editor, never in frontend.
# No Supabase service-role / secret key is required by the website.
